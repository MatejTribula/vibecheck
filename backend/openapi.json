{
  "openapi": "3.0.3",
  "info": {
    "title": "Vibe Check API",
    "version": "1.0.0"
  },
  "paths": {
    "/": {
      "get": {
        "summary": "Check that the backend is running",
        "responses": {
          "200": {
            "description": "Backend is running",
            "content": {
              "text/html": {
                "schema": {
                  "type": "string"
                },
                "example": "Backend is running"
              }
            }
          }
        }
      }
    },
    "/api/auth/register": {
      "post": {
        "tags": [
          "Authentication"
        ],
        "summary": "Register an account",
        "description": "Creates an account. Log in separately to receive a session token.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "displayName",
                  "email",
                  "password"
                ],
                "properties": {
                  "displayName": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 100
                  },
                  "email": {
                    "type": "string",
                    "format": "email",
                    "maxLength": 254
                  },
                  "password": {
                    "type": "string",
                    "format": "password",
                    "minLength": 8,
                    "maxLength": 128
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Account created",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UserResult"
                }
              }
            }
          },
          "400": {
            "description": "Invalid input or malformed JSON",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResult"
                }
              }
            }
          },
          "409": {
            "description": "Email already registered",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResult"
                }
              }
            }
          },
          "500": {
            "description": "Unexpected server error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResult"
                }
              }
            }
          }
        }
      }
    },
    "/api/auth/login": {
      "post": {
        "tags": [
          "Authentication"
        ],
        "summary": "Log in and create a session",
        "description": "Returns a token valid for 30 days. Paste it into Authorize to use the session endpoints.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "email",
                  "password"
                ],
                "properties": {
                  "email": {
                    "type": "string",
                    "format": "email",
                    "maxLength": 254
                  },
                  "password": {
                    "type": "string",
                    "format": "password",
                    "minLength": 8,
                    "maxLength": 128
                  },
                  "firebaseRegistrationId": {
                    "type": "string",
                    "nullable": true,
                    "minLength": 1,
                    "maxLength": 4096
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Login successful",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LoginResult"
                }
              }
            }
          },
          "400": {
            "description": "Invalid input or malformed JSON",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResult"
                }
              }
            }
          },
          "401": {
            "description": "Invalid email or password",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResult"
                }
              }
            }
          },
          "500": {
            "description": "Unexpected server error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResult"
                }
              }
            }
          }
        }
      }
    },
    "/api/sessions/current": {
      "get": {
        "tags": [
          "Sessions"
        ],
        "summary": "Validate the current session token",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Session is valid",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SessionResult"
                }
              }
            }
          },
          "401": {
            "description": "Token is missing, invalid or expired",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResult"
                }
              }
            }
          },
          "500": {
            "description": "Unexpected server error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResult"
                }
              }
            }
          }
        }
      }
    },
    "/api/sessions/logout": {
      "post": {
        "tags": [
          "Sessions"
        ],
        "summary": "Log out of the current session",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Session deleted",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EmptyResult"
                }
              }
            }
          },
          "401": {
            "description": "Token is missing, invalid or expired",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResult"
                }
              }
            }
          },
          "500": {
            "description": "Unexpected server error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResult"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "description": "Login session token"
      }
    },
    "schemas": {
      "User": {
        "type": "object",
        "required": [
          "id",
          "displayName",
          "email",
          "createdAt"
        ],
        "properties": {
          "id": {
            "type": "integer"
          },
          "displayName": {
            "type": "string"
          },
          "email": {
            "type": "string",
            "format": "email",
            "maxLength": 254
          },
          "createdAt": {
            "type": "string",
            "example": "2026-10-27 21:00:00"
          }
        }
      },
      "Session": {
        "type": "object",
        "required": [
          "id",
          "userId",
          "expiresAt"
        ],
        "properties": {
          "id": {
            "type": "integer"
          },
          "userId": {
            "type": "integer"
          },
          "expiresAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "Login": {
        "type": "object",
        "required": [
          "user",
          "token",
          "expiresAt"
        ],
        "properties": {
          "user": {
            "$ref": "#/components/schemas/User"
          },
          "token": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "expiresAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "UserResult": {
        "type": "object",
        "required": [
          "value",
          "errorCode",
          "message",
          "hasError"
        ],
        "properties": {
          "value": {
            "$ref": "#/components/schemas/User"
          },
          "errorCode": {
            "type": "string",
            "enum": [
              "None"
            ]
          },
          "message": {
            "type": "string",
            "nullable": true,
            "example": null
          },
          "hasError": {
            "type": "boolean",
            "enum": [
              false
            ]
          }
        }
      },
      "LoginResult": {
        "type": "object",
        "required": [
          "value",
          "errorCode",
          "message",
          "hasError"
        ],
        "properties": {
          "value": {
            "$ref": "#/components/schemas/Login"
          },
          "errorCode": {
            "type": "string",
            "enum": [
              "None"
            ]
          },
          "message": {
            "type": "string",
            "nullable": true,
            "example": null
          },
          "hasError": {
            "type": "boolean",
            "enum": [
              false
            ]
          }
        }
      },
      "SessionResult": {
        "type": "object",
        "required": [
          "value",
          "errorCode",
          "message",
          "hasError"
        ],
        "properties": {
          "value": {
            "$ref": "#/components/schemas/Session"
          },
          "errorCode": {
            "type": "string",
            "enum": [
              "None"
            ]
          },
          "message": {
            "type": "string",
            "nullable": true,
            "example": null
          },
          "hasError": {
            "type": "boolean",
            "enum": [
              false
            ]
          }
        }
      },
      "EmptyResult": {
        "type": "object",
        "required": [
          "value",
          "errorCode",
          "message",
          "hasError"
        ],
        "properties": {
          "value": {
            "type": "object",
            "nullable": true,
            "example": null
          },
          "errorCode": {
            "type": "string",
            "enum": [
              "None"
            ]
          },
          "message": {
            "type": "string",
            "nullable": true,
            "example": null
          },
          "hasError": {
            "type": "boolean",
            "enum": [
              false
            ]
          }
        }
      },
      "ErrorResult": {
        "type": "object",
        "required": [
          "value",
          "errorCode",
          "message",
          "hasError"
        ],
        "properties": {
          "value": {
            "type": "object",
            "nullable": true,
            "example": null
          },
          "errorCode": {
            "type": "string",
            "enum": [
              "InvalidRequest",
              "Unauthorized",
              "Forbidden",
              "NotFound",
              "DuplicateEntity",
              "InternalError"
            ]
          },
          "message": {
            "type": "string"
          },
          "hasError": {
            "type": "boolean",
            "enum": [
              true
            ]
          }
        }
      }
    }
  }
}
